{
  "installCommand": "npm install && chmod +x node_modules/.bin/*",
  "buildCommand": "npx --yes vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://backend-yy3a.onrender.com/api/:path*" },
    { "source": "/files/:path*", "destination": "https://backend-yy3a.onrender.com/files/:path*" }
  ]
}
